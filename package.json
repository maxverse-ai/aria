{
  "name": "@maxverse-ai/aria",
  "version": "0.3.1",
  "description": "A local-first control plane for running your CLI coding agents as a team in chat",
  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxverse-ai/aria.git"
  },
  "bugs": {
    "url": "https://github.com/maxverse-ai/aria/issues"
  },
  "homepage": "https://github.com/maxverse-ai/aria#readme",
  "bin": {
    "aria": "./bin/aria.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build:web": "vite build web",
    "build": "pnpm build:web && tsup",
    "typecheck": "tsc --noEmit && pnpm typecheck:web",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "pretest": "pnpm build:web",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:process": "vitest run tests/process --passWithNoTests",
    "infra:doctor": "node tools/infra-doctor.mjs",
    "check": "git diff --check && pnpm infra:doctor && pnpm release:check && pnpm typecheck && pnpm test:unit",
    "artifact:build": "pnpm build && node tools/artifact.mjs build",
    "artifact:verify": "node tools/artifact.mjs verify",
    "release:check": "node tools/release-policy.mjs check",
    "release:plan": "node tools/release-policy.mjs plan",
    "release:verify": "node tools/release-policy.mjs verify",
    "release:status": "node tools/release.mjs plan",
    "release:prepare": "node tools/release.mjs prepare-patch",
    "release:gate": "node tools/release.mjs verify",
    "release:publish": "node tools/release.mjs publish",
    "internal-release:gate": "node tools/internal-release.mjs context-gate",
    "internal-release:prepare": "node tools/internal-release.mjs prepare",
    "ci:local": "git diff --check && pnpm infra:doctor && pnpm release:check -- --base-ref origin/main && pnpm test && pnpm typecheck && pnpm build",
    "ci:platform": "pnpm infra:doctor && pnpm release:check && pnpm test && pnpm typecheck && pnpm build",
    "prepare": "pnpm build",
    "prepublishOnly": "node tools/release.mjs publish-gate && pnpm release:check && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@larksuite/channel": "^0.4.1",
    "commander": "^12.1.0",
    "cross-spawn": "^7.0.6",
    "graceful-fs": "^4.2.11",
    "marked": "^18.0.11",
    "proper-lockfile": "^4.1.2",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@astryxdesign/build": "0.5.2",
    "@astryxdesign/core": "0.5.2",
    "@astryxdesign/theme-neutral": "0.5.2",
    "@heroicons/react": "2.2.0",
    "@stylexjs/babel-plugin": "0.19.0",
    "@stylexjs/stylex": "0.19.0",
    "@stylexjs/unplugin": "0.19.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/graceful-fs": "^4.1.9",
    "@types/node": "^22.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "aria",
    "agents",
    "coding-agents",
    "control-plane",
    "self-hosted",
    "claude",
    "claude-code",
    "codex",
    "cli",
    "channel",
    "bridge"
  ],
  "license": "MIT"
}
